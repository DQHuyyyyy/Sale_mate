{
  "description": "Record every Codex user prompt in the project AI log.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "commandWindows": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
