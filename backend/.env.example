# ============================================
# SalesMate backend — mẫu biến môi trường
# ============================================
# Copy file này thành backend/.env rồi điền giá trị thật.
# KHÔNG commit backend/.env. Không đưa bất kỳ giá trị nào dưới đây ra frontend.

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# CHỈ dùng ở backend — key này bỏ qua Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BUCKET=apartment-images

# ---- Database (Supabase connection pooler) ----
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# ---- Auth ----
# Chuỗi ngẫu nhiên dài. Sinh nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<chuoi-ngau-nhien-dai>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- Chatbot ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
