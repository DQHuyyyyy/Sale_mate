# ============================================
# SalesMate — Biến môi trường
# ============================================
# Copy file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit .env lên git.

# ---- LLM ----
OPENAI_API_KEY=sk-your-key-here
# Model rẻ cho router/phân loại/gợi ý, model mạnh cho câu trả lời cuối.
#
# LLM_MODEL_FAST: gpt-5.6-luna ($0.20/$1.20 mỗi triệu token) RẺ HƠN gpt-4o-mini
# trước đó. Tài khoản chưa có quyền dùng thì đặt lại thành gpt-4o-mini.
LLM_MODEL_FAST=gpt-5.6-luna
#
# LLM_MODEL_ANSWER: CỐ Ý vẫn để gpt-4o. Đây là khâu duy nhất từng có hồi quy
# thật khi đổi sang model rẻ — gpt-4o-mini bỏ qua luật trích nguồn trên
# production trong khi gpt-4o ở local thì tuân. Muốn thử luna thì ĐO trước:
#
#   python -m src.cli eval answer --label goc
#   LLM_MODEL_ANSWER=gpt-5.6-luna python -m src.cli eval answer --label luna
#   python -m src.cli eval answer --doi-chieu goc luna
#
# Chỉ đổi mặc định khi cột phai_tu_choi KHÔNG giảm và dòng "Nguồn" vẫn hiện.
LLM_MODEL_ANSWER=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---- Orchestrator (Claude Sonnet 5, nhánh leo thang) ----
# Thiếu key thì app VẪN chạy đủ chức năng, chỉ tắt phần xử lý câu nhiều bước.
#
# ⚠️ Biến môi trường của HỆ ĐIỀU HÀNH đè lên file này. Đặt key ở đây mà máy còn
# một ANTHROPIC_API_KEY cũ trong env thì key cũ thắng, và lỗi trả về là "credit
# balance too low" — dẫn người đọc đi nạp tiền thay vì đi xoá biến. Lúc khởi
# động app có cảnh báo cho trường hợp này.
ANTHROPIC_API_KEY=
ENABLE_ORCHESTRATOR=false
ORCHESTRATOR_MODEL=claude-sonnet-5
# Adaptive thinking bật mặc định và token suy nghĩ tính theo giá ĐẦU RA.
# `effort` là cần ga chi phí chính: low → medium → high → xhigh → max.
ORCHESTRATOR_EFFORT=low
ORCHESTRATOR_MAX_TOKENS=4096
ORCHESTRATOR_MAX_ITERATIONS=3
# Phanh chống tai nạn, tính theo ngày UTC. 0 = không giới hạn. Hết ngân sách thì
# rơi về đường tất định, khách VẪN có câu trả lời — không báo lỗi.
ORCHESTRATOR_DAILY_BUDGET_USD=0
#
# Khi nào Sonnet 5 chạy:
#   tat        — không bao giờ
#   khi_thieu  — chỉ khi một trong ba luật hẹp dưới đây khớp
#   moi_luot   — MỌI câu cần tra cứu (câu xã giao vẫn bỏ qua)
# Đo trên máy thật: ba luật hẹp khớp 0/8 câu điển hình, nên mặc định là moi_luot
# — chạy rộng rồi siết theo số đo, đừng thiết kế hẹp sẵn rồi hy vọng nó vừa.
CHE_DO_LEO_THANG=moi_luot
# Chỉ có tác dụng khi CHE_DO_LEO_THANG=khi_thieu. Mỗi luật một cờ riêng để lúc
# chi phí vọt lên còn biết luật nào gây ra.
LEO_THANG_R1=true
LEO_THANG_R2=false
LEO_THANG_R3=false

# ---- Vector store (Qdrant Cloud — free 1GB, không cần thẻ) ----
# Local:  docker compose up -d qdrant  →  http://localhost:6333/dashboard
# Cloud:  https://cloud.qdrant.io  →  Create cluster  →  copy URL + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_chunks
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Truy hồi ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Dưới ngưỡng này agent trả lời "chưa đủ dữ liệu" thay vì suy đoán.
COVERAGE_THRESHOLD=0.35

# ---- Vòng lặp agent ----
# Bật thì agent tự quyết gọi tool nào và lặp tối đa AGENT_MAX_ITERATIONS lượt
# để gom đủ dữ kiện — cần cho câu hỏi nhiều bước như "so sánh căn A và căn B".
# Tắt thì chạy đường tất định: mỗi node đúng một lần, rẻ hơn nhưng không so sánh
# được. Tắt bằng biến môi trường là cứu hoả không cần deploy lại.
ENABLE_AGENT_LOOP=true
AGENT_MAX_ITERATIONS=2

# ---- Database (Supabase Postgres — free 500MB) ----
# Lấy ở Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:<mật-khẩu>@db.<ref>.supabase.co:5432/postgres
# Local bằng Docker:
# DATABASE_URL=postgresql://salesmate:salesmate@localhost:5432/salesmate

# ---- Supabase ----
# Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
# ⚠️ service_role BỎ QUA MỌI RLS — chỉ để ở server, không bao giờ đưa ra frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=apartment-images

# ---- Google Drive (script nối ảnh, chạy một lần) ----
# Chỉ cần API key, KHÔNG cần Service Account — folder để "Bất kỳ ai có đường liên kết".
# Lấy key: console.cloud.google.com → bật Google Drive API → Credentials → API key
DRIVE_API_KEY=AIza...
# Dán được cả link lẫn id. Phải là folder CHA chứa mọi folder căn.
DRIVE_PARENT_FOLDER_ID=https://drive.google.com/drive/folders/...

# ---- App (lõi AI ở src/) ----
# Cổng 8000 đã dành cho API sản phẩm ở backend/ — lõi AI chạy ở 8001.
APP_ENV=development
APP_PORT=8001
APP_HOST=0.0.0.0
# Frontend Vite chạy ở 5173; backend/ gọi server-to-server nên không cần CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Nhật ký theo phiên: mỗi cuộc trò chuyện một file .jsonl, tên theo ngày-giờ.
# Chỉ để theo dõi ở máy local — thư mục này đã gitignore. Rỗng = tắt hẳn.
LOG_DIR=logs
CHAT_MAX_CHARS=2000

# ---- LangSmith (AI Logs — deliverable #4 của BTC) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=salesmate
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (BTC cấp) ----
# Thay AI_LOG_API_KEY bằng key riêng của team lấy từ link mời của BTC.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-team-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Frontend Vite gọi thẳng /api và được vite.config.js proxy sang API sản phẩm ở
# cổng 8000, nên không cần biến môi trường nào.

# ---- API sản phẩm (interface/backend/) ----
# Nó đọc CHÍNH file .env này, không có file .env riêng nữa.
# Ngoài các biến Supabase và DATABASE_URL ở trên, nó cần thêm:

# Chuỗi ngẫu nhiên, tối thiểu 32 ký tự — ngắn hơn là backend từ chối khởi động.
# Sinh nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<chuoi-ngau-nhien-dai>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Trỏ về lõi AI ở trên. Bỏ trống là tính năng chat tắt.
AI_CORE_URL=http://localhost:8001
AI_CORE_TIMEOUT=60

# Hạn mức cho các endpoint AI tốn tiền:
#   /api/chat          khách 10 lượt · đã đăng nhập 60 lượt
#   /api/images/modify khách  5 lượt · đã đăng nhập 20 lượt   (sinh ảnh đắt hơn nhiều)
# Cửa sổ 10 phút. Đặt false để tự test không bị chặn. ĐỪNG để false ở môi trường
# công khai — hai endpoint này ai gọi cũng được và mỗi lượt đều tốn tiền model.
CHAT_RATE_LIMIT_ENABLED=true

# ---- Sinh ảnh: tính năng "Modify Object" trong widget chat ----
# Người dùng đang xem một ảnh của căn, gõ "đổi sofa thành màu nâu" và nhận ảnh
# mới. Ảnh KHÔNG được lưu — nó là ảnh minh hoạ do AI tạo cho một tài sản có
# thật, lưu cạnh ảnh thật là quảng cáo sai sự thật.
#
# Đổi nhà cung cấp bằng biến này, không phải sửa code.
IMAGE_PROVIDER=openai

# --- openai --- dùng lại OPENAI_API_KEY ở đầu file, không cần key riêng.
# gpt-image-1-mini là bản rẻ. Khác: gpt-image-1, gpt-image-1.5, gpt-image-2.
# Phải là model hỗ trợ /v1/images/edits (SỬA ảnh có sẵn), không chỉ sinh từ chữ.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# "auto" giữ đúng khổ ảnh gốc. Ép 1024x1024 thì ảnh căn hộ (khổ ngang) bị méo.
OPENAI_IMAGE_SIZE=auto

# --- gemini --- lấy key ở https://aistudio.google.com/apikey
# ⚠️ Gói FREE cấp hạn mức 0 cho MỌI model sinh ảnh — phải bật thanh toán
#    (billing) cho project, nếu không mọi lời gọi đều trả 429 "limit: 0".
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Sinh ảnh mất 40-60 giây, lâu hơn hẳn một câu trả lời văn bản.
IMAGE_TIMEOUT_S=300
