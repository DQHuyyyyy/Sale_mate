# ============================================
# SalesMate — Biến môi trường
# ============================================
# Copy file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit .env lên git.

# ---- LLM ----
OPENAI_API_KEY=sk-your-key-here
# Model rẻ cho router/phân loại, model mạnh cho câu trả lời cuối.
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_ANSWER=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---- Vector store (Qdrant Cloud — free 1GB, không cần thẻ) ----
# Local:  docker compose up -d qdrant  →  http://localhost:6333/dashboard
# Cloud:  https://cloud.qdrant.io  →  Create cluster  →  copy URL + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_chunks
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Truy hồi ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Dưới ngưỡng này agent trả lời "chưa đủ dữ liệu" thay vì suy đoán.
COVERAGE_THRESHOLD=0.35

# ---- Database (Supabase Postgres — free 500MB) ----
# Lấy ở Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:<mật-khẩu>@db.<ref>.supabase.co:5432/postgres
# Local bằng Docker:
# DATABASE_URL=postgresql://salesmate:salesmate@localhost:5432/salesmate

# ---- Supabase ----
# Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
# ⚠️ service_role BỎ QUA MỌI RLS — chỉ để ở server, không bao giờ đưa ra frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=apartment-images

# ---- Google Drive (script nối ảnh, chạy một lần) ----
# Chỉ cần API key, KHÔNG cần Service Account — folder để "Bất kỳ ai có đường liên kết".
# Lấy key: console.cloud.google.com → bật Google Drive API → Credentials → API key
DRIVE_API_KEY=AIza...
# Dán được cả link lẫn id. Phải là folder CHA chứa mọi folder căn.
DRIVE_PARENT_FOLDER_ID=https://drive.google.com/drive/folders/...

# ---- App (lõi AI ở src/) ----
# Cổng 8000 đã dành cho API sản phẩm ở backend/ — lõi AI chạy ở 8001.
APP_ENV=development
APP_PORT=8001
APP_HOST=0.0.0.0
# Frontend Vite chạy ở 5173; backend/ gọi server-to-server nên không cần CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
CHAT_MAX_CHARS=2000

# ---- LangSmith (AI Logs — deliverable #4 của BTC) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=salesmate
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (BTC cấp) ----
# Thay AI_LOG_API_KEY bằng key riêng của team lấy từ link mời của BTC.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-team-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Frontend Vite gọi thẳng /api và được vite.config.js proxy sang API sản phẩm ở
# cổng 8000, nên không cần biến môi trường nào.

# ---- API sản phẩm (interface/backend/) ----
# Nó đọc CHÍNH file .env này, không có file .env riêng nữa.
# Ngoài các biến Supabase và DATABASE_URL ở trên, nó cần thêm:

# Chuỗi ngẫu nhiên, tối thiểu 32 ký tự — ngắn hơn là backend từ chối khởi động.
# Sinh nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<chuoi-ngau-nhien-dai>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Trỏ về lõi AI ở trên. Bỏ trống là tính năng chat tắt.
AI_CORE_URL=http://localhost:8001
AI_CORE_TIMEOUT=60
