# ============================================
# SalesMate — Biến môi trường
# ============================================
# Copy file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit .env lên git.

# ---- LLM ----
OPENAI_API_KEY=sk-your-key-here
# Model rẻ cho router/phân loại, model mạnh cho câu trả lời cuối.
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_ANSWER=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---- Vector store (Qdrant) ----
# Local: docker compose up -d qdrant  →  dashboard http://localhost:6333/dashboard
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_chunks
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Truy hồi ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Dưới ngưỡng này agent trả lời "chưa đủ dữ liệu" thay vì suy đoán.
COVERAGE_THRESHOLD=0.35

# ---- Database ----
DATABASE_URL=postgresql://salesmate:salesmate@localhost:5432/salesmate
# Dev nhanh không cần Postgres:
# DATABASE_URL=sqlite:///./data/app.db

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
CHAT_MAX_CHARS=2000

# ---- LangSmith (AI Logs — deliverable #4 của BTC) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=salesmate
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (BTC cấp) ----
# Thay AI_LOG_API_KEY bằng key riêng của team lấy từ link mời của BTC.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-team-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (đặt trong frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
