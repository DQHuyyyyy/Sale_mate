# Frontend chỉ được chứa cấu hình công khai. TUYỆT ĐỐI không đặt
# SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, JWT_SECRET hay OPENAI_API_KEY ở đây —
# mọi biến VITE_* đều nằm trong bundle mà ai cũng đọc được.

# Bỏ trống khi chạy dev: vite.config.js đã proxy /api sang http://localhost:8000.
# Khi deploy, điền domain backend, ví dụ https://api.salesmate.vn
VITE_API_BASE_URL=
