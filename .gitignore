interface/frontend/.next/
interface/frontend/out/
interface/frontend/node_modules/
interface/frontend/.env.local
interface/frontend/dist/

# Coverage
.coverage
coverage.xml
htmlcov/

# Windows tạo file rác tên NUL khi shell POSIX chạy `2>NUL` — nó là tên thiết bị
# trên Windows nhưng thành file thật dưới Git Bash. Luôn rỗng, không bao giờ có
# nghĩa gì.
NUL
