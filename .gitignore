# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production
# ⚠️ Bản sao lưu của .env cũng chứa NGUYÊN khoá production — OPENAI_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY (bỏ qua RLS), DATABASE_URL kèm mật khẩu. Chỉ chặn
# `.env` thôi thì một file `.env.bak` nằm cạnh vẫn lọt vào `git add -A`.
.env.*
!.env.example

# Khoá dịch vụ — KHÔNG BAO GIỜ commit
